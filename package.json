{
  "name": "lol-skin-library",
  "version": "1.3.1",
  "description": "LOL Skin Library - View your missing skins collection",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "keywords": [
    "league-of-legends",
    "skins",
    "lcu-api"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "league-connect": "^5.5.0",
    "open": "^11.0.0",
    "systray2": "^2.1.4"
  },
  "build": {
    "appId": "com.lolskinlibrary.app",
    "productName": "LOL Skin Library",
    "directories": {
      "output": "build-electron"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "LOL-Skin-Library-App.exe"
    }
  },
  "devDependencies": {
    "caxa": "^3.0.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "fs-extra": "^11.3.5",
    "jimp": "^0.16.1",
    "png-to-ico": "^3.0.1",
    "puppeteer-core": "^25.1.0",
    "rcedit": "^5.0.2"
  }
}
